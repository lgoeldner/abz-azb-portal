# Production only. Copy to .env and replace every value before deployment.
APP_VERSION=latest
PUBLIC_URL=https://zeitung.example.eu
PUBLIC_HOST=zeitung.example.eu
BETTER_AUTH_URL=https://zeitung.example.eu
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=replace-with-a-long-random-secret
AUTH_SERVICE_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_SECRET=replace-with-a-separate-at-least-32-random-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes

# The sender and domain must be verified in Brevo before enabling delivery.
MAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-brevo-api-key
MAIL_FROM=AbiZeitBetrug <login@notify.example.org>
MAIL_REPLY_TO=organisers@example.org
MAIL_DAILY_LIMIT=300
REMINDER_DAILY_LIMIT=150
REMINDERS_ENABLED=false

# Use independent EU S3-compatible or REST storage. Keep these credentials and
# the repository password outside the VPS backup volumes.
RESTIC_REPOSITORY=s3:https://s3.eu-central-1.example.eu/abizeitung-backups/portal
RESTIC_PASSWORD=replace-with-a-separate-long-random-secret
AWS_ACCESS_KEY_ID=replace-with-backup-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-secret
AWS_DEFAULT_REGION=eu-central-1
BACKUP_HEARTBEAT_URL=https://monitor.example.eu/api/push/replace-with-monitor-token

# Set true only after disabling open and click tracking in the Brevo account.
BREVO_TRACKING_DISABLED=false
MAIL_LOGIN_RESERVE=150
# Only proxy networks that overwrite forwarded headers; empty trusts socket IP only.
TRUSTED_PROXY_CIDRS=
