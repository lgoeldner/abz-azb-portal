{$PUBLIC_HOST} {
	encode zstd gzip

	@internal path /internal /internal/*
	respond @internal 404

	@go path /api /api/* /auth /auth/* /healthz /readyz
	handle @go {
		reverse_proxy portal:8080 {
		header_up X-Portal-Proxy-Token {$AUTH_SERVICE_SECRET}
	}
	}

	handle {
		reverse_proxy frontend:5173
	}
}
