{
	auto_https off
	servers {
		# The edge sets X-Forwarded-For; trust it only from the egress gateway, where the tunnel's requests come from.
		trusted_proxies static {$EDGE_PROXY_IP}/32
	}
}

http://{$PUBLIC_HOST} {
	encode zstd gzip

	@internal path /internal /internal/*
	respond @internal 404
	reverse_proxy portal:8080 {
		header_up X-Portal-Proxy-Token {$AUTH_SERVICE_SECRET}
	}
}
