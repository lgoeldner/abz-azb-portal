# Managed by Ansible.
{% if edge_acme_email %}
{
	email {{ edge_acme_email }}
}
{% endif %}
{% for site in edge_sites %}

{{ site.host }} {
{% if edge_tls_internal %}
	tls internal
{% endif %}
{% if site.hooks_upstream | default('') %}
	handle /hooks/* {
		reverse_proxy {{ site.hooks_upstream }}
	}
	handle {
		reverse_proxy {{ site.upstream }}
	}
{% else %}
	reverse_proxy {{ site.upstream }}
{% endif %}
}
{% endfor %}
