# Managed by Ansible.
{% if edge_acme_email %}
{
	email {{ edge_acme_email }}
}
{% endif %}
{% for site in edge_sites %}

{{ site.host }} {
{% if edge_tls_internal %}
	tls internal
{% endif %}
{% if site.hooks_upstream | default('') %}
	handle /hooks/* {
		reverse_proxy {{ site.hooks_upstream }}
	}
	handle {
		reverse_proxy {{ site.upstream }}
	}
{% else %}
	reverse_proxy {{ site.upstream }}
{% endif %}
}
{% endfor %}
{% if edge_static_hosts | default([]) %}

# Placeholder page until production goes live; files come from roles/edge/files/construction.
{{ edge_static_hosts | join(', ') }} {
{% if edge_tls_internal %}
	tls internal
{% endif %}
	root * /etc/caddy/site
	encode zstd gzip
	file_server
}
{% endif %}
