# Managed by Ansible (ops/ansible/roles/test_host). Edits are overwritten.
COMPOSE_FILE=compose.yaml:compose.test.yaml
COMPOSE_PROFILES=production
IMAGE_PREFIX={{ test_image_prefix }}
APP_VERSION={{ test_app_version }}

PUBLIC_URL=https://{{ test_host }}
PUBLIC_HOST={{ test_host }}
BETTER_AUTH_URL=https://{{ test_host }}
# Caddy publishes on loopback only; tunnel traffic reaches it from the egress gateway (subnet pinned in compose.test.yaml).
TEST_BIND_IP=127.0.0.1
EDGE_PROXY_IP=172.30.77.1
TRUSTED_PROXY_CIDRS=172.30.77.1/32

POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD={{ test_postgres_password }}
AUTH_SERVICE_SECRET={{ test_auth_service_secret }}
BETTER_AUTH_SECRET={{ test_better_auth_secret }}
SESSION_SECRET={{ test_session_secret }}

MAIL_PROVIDER=brevo
BREVO_API_KEY={{ test_brevo_api_key }}
MAIL_FROM={{ test_mail_from }}
MAIL_REPLY_TO={{ test_mail_reply_to }}
MAIL_DAILY_LIMIT={{ test_mail_daily_limit }}
MAIL_LOGIN_RESERVE={{ test_mail_login_reserve }}
REMINDER_DAILY_LIMIT={{ test_reminder_daily_limit }}
BREVO_TRACKING_DISABLED={{ test_brevo_tracking_disabled | lower }}
REMINDERS_ENABLED=false
PROJECT_MANAGEMENT={{ test_project_management | lower }}

RESTIC_REPOSITORY=/restic
RESTIC_PASSWORD={{ test_restic_password }}
BACKUP_HEARTBEAT_URL=http://portal:8080/healthz
