# Copy to an ignored local file, edit, then export its values before invoking
# scripts/firebase-deploy.sh. Do not put secret values here.
PROJECT_ID=replace-with-existing-firebase-project-id
CLOUD_RUN_REGION=europe-west1
CLOUD_RUN_SERVICE=abizeitbetrug
CLOUD_RUN_SERVICE_ACCOUNT=portal-runtime@replace-with-existing-firebase-project-id.iam.gserviceaccount.com
ARTIFACT_REGISTRY_REPOSITORY=portal-images
UPLOAD_BUCKET=replace-with-private-eu-bucket-name
PUBLIC_URL=https://replace-with-existing-firebase-project-id.web.app
OIDC_ISSUER=https://replace-with-your-existing-oidc-issuer
OIDC_CLIENT_ID=replace-with-existing-oidc-client-id
BOOTSTRAP_ADMIN_SUBJECT=replace-with-exact-oidc-subject

# Optional: pin the image tag. If omitted, the script uses the current Git
# revision plus a UTC timestamp.
# DEPLOY_IMAGE_TAG=20261029-1a2b3c4

# Optional: set to 1 to run all preflight checks and print the plan without
# building or deploying anything.
# DEPLOY_DRY_RUN=1
