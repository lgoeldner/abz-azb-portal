# Local-only values for `make dev`; not suitable for production.
APP_VERSION=dev
# Works on any Docker engine. OrbStack users may use caddy.abizeitung-portal.orb.local instead.
PUBLIC_URL=https://localhost
PUBLIC_HOST=localhost
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal-dev
SESSION_SECRET=development-only-secret-change-for-production
RESTIC_REPOSITORY=/restic
RESTIC_PASSWORD=development-only
AWS_DEFAULT_REGION=eu-central-1
BACKUP_HEARTBEAT_URL=http://portal:8080/healthz
AUTH_SERVICE_SECRET=dev-only-service-secret-at-least-32-bytes
BETTER_AUTH_SECRET=development-better-auth-secret-change-for-production
MAIL_PROVIDER=capture
MAIL_FROM=AbiZeitBetrug <login@example.test>
REMINDERS_ENABLED=false
MOCK_AUTH_SECRET=dev-only-mock-secret-at-least-32-bytes
