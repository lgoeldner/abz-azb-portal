# Local-only values for `make dev`; not suitable for production.
APP_VERSION=dev
PUBLIC_URL=http://localhost:8080
PUBLIC_HOST=localhost
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal-dev
OIDC_ISSUER=http://localhost:8080/dev/oidc
OIDC_CLIENT_ID=portal-dev
OIDC_CLIENT_SECRET=dev-only
SESSION_SECRET=development-only-secret-change-for-production
BOOTSTRAP_ADMIN_SUBJECT=dev-admin
RESTIC_REPOSITORY=/tmp/unused-restic
RESTIC_PASSWORD=development-only
AWS_DEFAULT_REGION=eu-central-1
BACKUP_HEARTBEAT_URL=http://localhost/unused
